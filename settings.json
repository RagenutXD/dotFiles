{
    "editor.fontSize": 21,
    "editor.fontFamily": "JetBrains Mono",
    
    "editor.lineNumbers": "relative",
    "vim.leader": " ",
    "vim.normalModeKeyBindingsNonRecursive": [
        {"before": ["<leader>", "p", "v"], "commands": [":Ex"]},
        {"before": ["<leader>", "p", "f"], "commands": ["workbench.action.quickOpen"]},
        {"before": ["<S-l>"], "commands": [":bnext"]},
        {"before": ["<S-h>"], "commands": [":bprev"]},
        {"before": ["<S-h>"], "commands": [":bprev"]},
    ],

    "code-runner.runInTerminal": true,
    "code-runner.ignoreSelection": true,
    "terminal.integrated.tabStopWidth": 4,
    "C_Cpp.copilotHover": "disabled",
    "github.copilot.nextEditSuggestions.fixes": false,
    "explorer.fileNesting.patterns": {
        "*.gd": "${basename}.gd.uid"
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "workbench.colorTheme": "Tokyo Night",
}